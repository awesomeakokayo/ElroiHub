# ElRoi Hub — Gmail-direct (Option A) + Stripe (USD)
# All inbound requests (contact, schedule, post-payment onboarding) are sent
# *from* and *to* Elroihub2502@gmail.com via Gmail API OAuth. No Resend/domain mail.

# ── Gmail OAuth — Option A (send from Elroihub2502@gmail.com itself) ──
# 1. Google Cloud Console → APIs & Services → Enable Gmail API
# 2. Credentials → Create OAuth 2.0 Client ID (Web application)
#    Authorized redirect URI: https://developers.google.com/oauthplayground
# 3. OAuth Playground (https://developers.google.com/oauthplayground)
#    - Select https://www.googleapis.com/auth/gmail.send
#    - Authorize with Elroihub2502@gmail.com, exchange code for tokens
#    - Copy refresh_token here
# Docs: lib/gmail.ts handles token refresh automatically.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional: override if you used a different redirect URI when creating the OAuth client
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
# Optional explicit from/to (defaults to Elroihub2502@gmail.com as coded in lib/gmail.ts)
# GMAIL_USER=Elroihub2502@gmail.com

# ── Legacy (no longer used — Resend removed) ──
# RESEND_API_KEY is intentionally NOT required anymore. If present it is ignored.
# EMAIL_FROM / NOTIFICATION_EMAIL also ignored — Gmail path is hardcoded to Elroihub2502@gmail.com.

# ── Stripe — checkout in USD (dollars) ──
# Leave STRIPE_SECRET_KEY empty to run mock checkout locally (no real charge, still shows success + booking).
# For live payments, add live keys (sk_live_ / pk_live_) and set NEXT_PUBLIC_SITE_URL to your production URL.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
